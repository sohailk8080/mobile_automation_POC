{
  "name": "appium-automation",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "clean:ports": "adb forward --remove-all && kill -9 $(lsof -t -i:8200,8201) 2>/dev/null || true",
    "test:local": "wdio run wdio.local.conf.ts",
    "report:generate": "allure generate allure-results --clean && allure open",
    "test:bs": "wdio run wdio.bs.conf.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Sohail Khan",
  "license": "ISC",
  "description": "Mobile Automation POC",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^8.38.0",
    "@wdio/browserstack-service": "^8.38.0",
    "@wdio/cli": "^8.38.0",
    "@wdio/local-runner": "^8.38.0",
    "@wdio/mocha-framework": "^8.38.0",
    "@wdio/spec-reporter": "^8.38.0",
    "allure-commandline": "^2.46.1",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.7.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
