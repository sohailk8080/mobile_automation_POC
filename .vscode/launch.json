{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Local Mobile Tests",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "test:local"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**",
        "node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Single Test File",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wdio",
        "run",
        "wdio.local.conf.ts",
        "--spec",
        "${relativeFile}"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**",
        "node_modules/**"
      ]
    }
  ]
}